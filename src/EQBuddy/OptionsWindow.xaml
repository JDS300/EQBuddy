<Window x:Class="EQBuddy.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EQBuddy Options" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        MinWidth="390" MaxWidth="900"
        WindowStartupLocation="Manual">
    <!-- MinWidth was 272, which predated the rule editor's later columns (spell-class
         picker, per-rule sound, delay): below ~390 the Name and Match boxes collapse to a
         character or two. Raising it also widens installs whose saved OptionsWidth was the
         old 340 default, since the width is clamped to MinWidth when the window opens. -->
    <!-- Custom chrome (WindowStyle=None + AllowsTransparency) has no native resize
         border, so width is driven by the drag handles on both edges below.
         SizeToContent stays on Height, but MaxHeight is clamped at runtime to the work
         area of whichever monitor the window is on — at high Windows scaling the content
         is taller than the screen, so the body has to scroll. The title row stays outside
         the scroll so ✕ is always reachable. -->
    <Border Background="{DynamicResource BgBrush}" CornerRadius="10"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            MouseLeftButtonDown="OnDrag">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16,16,16,6">
            <TextBlock Text="Options" FontWeight="Bold" FontSize="14"
                       Foreground="{DynamicResource AccentBrush}"/>
            <Button Style="{StaticResource IconButton}" Content="&#x2715;" ToolTip="Close"
                    HorizontalAlignment="Right" Click="OnClose"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
        <StackPanel Margin="16,0,16,16">

            <Grid>
                <TextBlock Text="Theme" FontSize="12"/>
                <ComboBox x:Name="ThemeCombo" HorizontalAlignment="Right" Width="130" FontSize="12"
                          SelectionChanged="OnThemeChanged"/>
            </Grid>

            <!-- Rows are built in code (UpdateCustomColorsPanel); visible only while the
                 Custom theme is selected. -->
            <StackPanel x:Name="CustomColorsPanel" Visibility="Collapsed" Margin="0,8,0,0"/>

            <Grid Margin="0,12,0,0">
                <TextBlock Text="Widget size" FontSize="12"/>
                <TextBlock x:Name="ScaleLabel" Text="100%" FontSize="12" HorizontalAlignment="Right"
                           Foreground="{DynamicResource AccentBrush}"/>
            </Grid>
            <Slider x:Name="ScaleSlider" Minimum="0.8" Maximum="1.6" TickFrequency="0.05"
                    IsSnapToTickEnabled="True" Margin="0,4,0,12"
                    ValueChanged="OnScaleChanged"/>

            <Grid>
                <TextBlock Text="Chips &amp; alerts size" FontSize="12"
                           ToolTip="Spawn timer chips, mez chips, and the alert banner"/>
                <TextBlock x:Name="ChipScaleLabel" Text="100%" FontSize="12" HorizontalAlignment="Right"
                           Foreground="{DynamicResource AccentBrush}"/>
            </Grid>
            <Slider x:Name="ChipScaleSlider" Minimum="0.8" Maximum="2.0" TickFrequency="0.05"
                    IsSnapToTickEnabled="True" Margin="0,4,0,12"
                    ValueChanged="OnChipScaleChanged"/>

            <Grid>
                <TextBlock Text="Background see-through" FontSize="12"/>
                <TextBlock x:Name="BgOpacityLabel" Text="95%" FontSize="12" HorizontalAlignment="Right"
                           Foreground="{DynamicResource AccentBrush}"/>
            </Grid>
            <TextBlock Text="Only the dark panel fades — text stays sharp." Style="{StaticResource Dim}"/>
            <Slider x:Name="BgOpacitySlider" Minimum="0.15" Maximum="1.0" TickFrequency="0.05"
                    IsSnapToTickEnabled="True" Margin="0,4,0,12"
                    ValueChanged="OnBgOpacityChanged"/>

            <Grid>
                <TextBlock Text="Whole-widget opacity" FontSize="12"/>
                <TextBlock x:Name="OpacityLabel" Text="96%" FontSize="12" HorizontalAlignment="Right"
                           Foreground="{DynamicResource AccentBrush}"/>
            </Grid>
            <TextBlock Text="Fades everything, text included." Style="{StaticResource Dim}"/>
            <Slider x:Name="OpacitySlider" Minimum="0.5" Maximum="1.0" TickFrequency="0.02"
                    IsSnapToTickEnabled="True" Margin="0,4,0,4"
                    ValueChanged="OnOpacityChanged"/>

            <CheckBox x:Name="TruncateCheck" Margin="0,12,0,0"
                      Checked="OnTruncateChanged" Unchecked="OnTruncateChanged">
                <TextBlock Text="Auto-empty finished-session logs" FontSize="12"
                           Foreground="{DynamicResource TextBrush}"/>
            </CheckBox>
            <TextBlock Text="Turn off if you use GINA/GamParse or upload your log files elsewhere — they will grow forever, so clean them up yourself occasionally. (Cleanup already stands down whenever the game, GINA, or GamParse is running.)"
                       Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="20,2,0,0"/>
            <CheckBox x:Name="ArchiveCheck" Margin="20,6,0,0"
                      Checked="OnArchiveChanged" Unchecked="OnArchiveChanged">
                <TextBlock Text="Keep a timestamped copy before emptying (Logs\archive)" FontSize="12"
                           Foreground="{DynamicResource TextBrush}"/>
            </CheckBox>
            <TextBlock Text="Each finished session is saved as eqlog_name_server_YYYYMMDDHHMMSS.txt — the stamp is when the session ended. Archives are yours to keep or clean up; EQBuddy never deletes them."
                       Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="40,2,0,0"/>

            <CheckBox x:Name="TutorialCheck" Margin="0,10,0,0"
                      Checked="OnTutorialToggled" Unchecked="OnTutorialToggled">
                <TextBlock Text="Show quick tutorial at launch" FontSize="12"
                           Foreground="{DynamicResource TextBrush}"/>
            </CheckBox>

            <CheckBox x:Name="TargetDropsCheck" Margin="0,10,0,0"
                      Checked="OnTargetDropsToggled" Unchecked="OnTargetDropsToggled">
                <TextBlock Text="🎯 Show target drops in the Loot card" FontSize="12"
                           Foreground="{DynamicResource TextBrush}"/>
            </CheckBox>
            <TextBlock Text="While you fight, the Loot card lists what the creature can drop (eqlwiki) with your own observed counts this session. Hover an item for its stats; click for full info."
                       Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="20,2,0,0"/>

            <CheckBox x:Name="HideUnfocusedCheck" Margin="0,10,0,0"
                      Checked="OnHideUnfocusedToggled" Unchecked="OnHideUnfocusedToggled">
                <TextBlock Text="Hide the widget while the game is running but not focused" FontSize="12"
                           Foreground="{DynamicResource TextBrush}"/>
            </CheckBox>
            <TextBlock Text="Alt-tab to a browser and the widget (and its chips and breakout windows) gets out of the way; alt-tab back to the game and everything returns. The widget always shows when the game isn't running."
                       Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="20,2,0,0"/>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Regen heals about" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextBrush}"/>
                <TextBox x:Name="RegenPerTickBox" Width="48" Margin="6,0,6,0" FontSize="12"
                         TextAlignment="Right" LostFocus="OnRegenPerTickChanged"
                         Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"/>
                <TextBlock Text="hp per tick (blank = wiki base)" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>
            <TextBlock Text="Hymn of Restoration and similar regen ticks never log an amount, so their healing is estimated. The wiki knows the unamplified base (Hymn: 9), but instruments and ranks raise the real number — read yours off the heal text over your head and type it here. Your number wins."
                       Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="20,2,0,0"/>

            <CheckBox x:Name="TrackSpawnsCheck" Margin="0,10,0,0"
                      Checked="OnTrackSpawnsToggled" Unchecked="OnTrackSpawnsToggled">
                <TextBlock Text="🕒 Track spawns (named respawn timers)" FontSize="12"
                           Foreground="{DynamicResource TextBrush}"/>
            </CheckBox>
            <TextBlock Text="Kill a named — or its placeholder — and a small countdown chicklet appears (⏳ Asaka L`Rei 3:12). Chicklets stack, drag anywhere as one, show every timer you have running in any zone, and flip to DUE for a minute (click to dismiss sooner). Double-click one (or right-click → Spawn timers…) for the full zone list, which follows you zone to zone. We captured the respawn times we could from community sources — if you notice a discrepancy in game, type over the duration: your number wins and survives updates."
                       Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="20,2,0,0"/>

            <Grid Margin="0,12,0,0">
                <TextBlock Text="Recent-rate window" FontSize="12"/>
                <ComboBox x:Name="WindowCombo" HorizontalAlignment="Right" Width="90" FontSize="12"
                          SelectionChanged="OnWindowChanged"/>
            </Grid>
            <TextBlock Text='The "Last Xm" figures on Combat, Kills, Money, and Progress.'
                       Style="{StaticResource Dim}" TextWrapping="Wrap"/>

            <TextBlock Text="Watch rules" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}" Margin="0,14,0,2"/>
            <TextBlock Text="Watch loot, kills, skill-ups, deaths, milestones, your spells wearing off, or any text in the log. Match is a case-insensitive substring, e.g. 'mote'. Spell fade rules can pick a whole class (Any crowd control, Charm, Mez, Root, Lull, Stun, HoT) instead of a named spell, needing no match text. Delay holds the alert back that many seconds so it lands as a cue. 🔔 shows a banner; the sound box picks this rule's own sound, so you can tell what happened by ear — 'Default' follows the shared choice below, 'Off' stays silent, 'Custom…' takes your own .wav/.mp3."
                       Style="{StaticResource Dim}" TextWrapping="Wrap"/>
            <!-- Collapsed by default: the examples answer the questions people actually ask
                 (is "Mote" enough? why isn't my rule matching?) but they're a wall of text
                 for anyone who already knows. -->
            <Button x:Name="GuideToggle" HorizontalAlignment="Left" Margin="0,4,0,0"
                    Style="{StaticResource IconButton}" FontSize="11"
                    Content="▸ Show examples"
                    ToolTip="Worked examples for every rule kind"
                    Click="OnGuideToggled"/>
            <Border x:Name="GuidePanel" Visibility="Collapsed" Margin="0,4,0,2"
                    Background="{DynamicResource PanelBrush}" CornerRadius="6" Padding="8,6">
                <StackPanel x:Name="GuideContent"/>
            </Border>
            <!-- Shared-size scope so the header row's Auto columns track the rule rows'. -->
            <StackPanel x:Name="RulesPanel" Margin="0,4,0,0" Grid.IsSharedSizeScope="True"/>
            <Button x:Name="AddRuleBtn" Content="+ Add watch rule" Style="{StaticResource ActionButton}"
                    HorizontalAlignment="Left" FontSize="12" Click="OnAddRule"/>
            <CheckBox x:Name="PinChipsCheck" Margin="0,6,0,0"
                      Checked="OnPinChipsChanged" Unchecked="OnPinChipsChanged">
                <TextBlock Text="📌 Show watch chips in the mini dashboard" FontSize="12"
                           Foreground="{DynamicResource TextBrush}"/>
            </CheckBox>

            <Grid Margin="0,8,0,0">
                <TextBlock Text="Alert sound" FontSize="12" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ComboBox x:Name="SoundCombo" Width="120" FontSize="12"
                              SelectionChanged="OnSoundChanged"/>
                    <Button Content="&#x25B6;" Style="{StaticResource IconButton}" FontSize="11"
                            ToolTip="Play the alert sound" Click="OnSoundTest" Margin="4,0,0,0"/>
                </StackPanel>
            </Grid>
            <Grid Margin="0,6,0,0">
                <TextBlock Text="Alert volume" FontSize="12"/>
                <TextBlock x:Name="AlertVolumeLabel" Text="100%" FontSize="12" HorizontalAlignment="Right"
                           Foreground="{DynamicResource AccentBrush}"/>
            </Grid>
            <Slider x:Name="AlertVolumeSlider" Minimum="0.1" Maximum="1.0" TickFrequency="0.05"
                    IsSnapToTickEnabled="True" Margin="0,4,0,4"
                    ValueChanged="OnAlertVolumeChanged"/>
            <TextBlock x:Name="SoundFileNote" Style="{StaticResource Dim}" TextWrapping="Wrap"
                       Visibility="Collapsed"/>
            <TextBlock Text="While Options is open, the ★ alert banner tile is visible — drag it to where alerts should appear. During play it's click-through and never steals focus."
                       Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,4,0,0"/>

            <TextBlock Text="Overlay cards" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}" Margin="0,14,0,2"/>
            <StackPanel x:Name="CardsPanel"/>

            <TextBlock Text="Breakout windows" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}" Margin="0,14,0,2"/>
            <TextBlock Text="Which floating windows may open while minimized (each still needs its ⭐ star — or a 📌 pinned rule for Watch). Unticking one here is the same as its ✕."
                       Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,2"/>
            <WrapPanel x:Name="BreakoutsPanel"/>

            <TextBlock Text="Size also scales all text. Changes apply instantly and are saved. Drag either side edge to widen this window."
                       Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
        </ScrollViewer>

        <!-- Width handles on both edges. Transparent template so they read as bare edges;
             the cursor is the affordance. Dragging the left edge moves Left as well as
             Width so the right edge stays put. Width is persisted on release. -->
        <Thumb x:Name="LeftGrip" Grid.RowSpan="2" Width="8"
               HorizontalAlignment="Left" VerticalAlignment="Stretch"
               Cursor="SizeWE" ToolTip="Drag to resize"
               DragStarted="OnResizeStarted" DragDelta="OnResizeLeftDelta"
               DragCompleted="OnResizeCompleted">
          <Thumb.Template>
            <ControlTemplate TargetType="Thumb"><Rectangle Fill="Transparent"/></ControlTemplate>
          </Thumb.Template>
        </Thumb>

        <Thumb x:Name="RightGrip" Grid.RowSpan="2" Width="8"
               HorizontalAlignment="Right" VerticalAlignment="Stretch"
               Cursor="SizeWE" ToolTip="Drag to resize"
               DragStarted="OnResizeStarted" DragDelta="OnResizeRightDelta"
               DragCompleted="OnResizeCompleted">
          <Thumb.Template>
            <ControlTemplate TargetType="Thumb"><Rectangle Fill="Transparent"/></ControlTemplate>
          </Thumb.Template>
        </Thumb>
      </Grid>
    </Border>
</Window>
