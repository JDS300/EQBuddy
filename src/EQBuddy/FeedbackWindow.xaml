<Window x:Class="EQBuddy.FeedbackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Send feedback" Width="380" SizeToContent="Height" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Border Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="8" Padding="14,10,14,12"
            MouseLeftButtonDown="OnDrag">
        <StackPanel>
            <Grid Margin="0,0,0,8">
                <TextBlock Text="Send feedback" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"/>
                <Button Content="✕" HorizontalAlignment="Right" Style="{StaticResource IconButton}"
                        Click="OnClose"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <RadioButton x:Name="FeatureRadio" IsChecked="True" Margin="0,0,16,0">
                    <TextBlock Text="💡 Feature request" FontSize="12"
                               Foreground="{DynamicResource TextBrush}"/>
                </RadioButton>
                <RadioButton x:Name="BugRadio">
                    <TextBlock Text="🐛 Bug report" FontSize="12"
                               Foreground="{DynamicResource TextBrush}"/>
                </RadioButton>
            </StackPanel>

            <TextBox x:Name="BodyBox" MinHeight="110" MaxHeight="240" TextWrapping="Wrap"
                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontSize="12"
                     Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"
                     BorderBrush="{DynamicResource BorderBrush}" Padding="6"
                     TextChanged="OnBodyChanged"/>
            <TextBlock x:Name="BugHint" Style="{StaticResource Dim}" TextWrapping="Wrap"
                       Margin="0,4,0,0" Visibility="Collapsed"
                       Text="For bugs: pasting the exact log lines (from Logs\eqlog_&lt;name&gt;_&lt;server&gt;.txt) around the moment it happened is the single most useful thing you can add."/>

            <TextBlock x:Name="AppendNote" Style="{StaticResource Dim}" TextWrapping="Wrap"
                       Margin="0,8,0,0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="SendBtn" Content="Continue on GitHub ↗" IsEnabled="False"
                        Style="{StaticResource ActionButton}" Click="OnSend"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
