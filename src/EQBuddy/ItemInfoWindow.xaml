<Window x:Class="EQBuddy.ItemInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EQBuddy Item Info" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Width="360" WindowStartupLocation="Manual">
    <!-- On-demand eqlwiki item lookup: click a loot row (or search here). One fetch per
         request, 7-day cache, honest LIVE/CACHED/STALE labels — the log names items
         exactly, so no OCR gymnastics needed. -->
    <Border Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="8" Padding="12" MouseLeftButtonDown="OnDrag">
        <StackPanel>
            <Grid Margin="0,0,0,6">
                <TextBlock x:Name="TitleText" Text="Item info" FontSize="13" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,40,0"
                           TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="StateChip" FontSize="10" VerticalAlignment="Center"
                               Foreground="{DynamicResource DimBrush}" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource IconButton}" Content="&#x2715;" ToolTip="Close"
                            Click="OnClose"/>
                </StackPanel>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" FontSize="12" KeyDown="OnSearchKey"
                         ToolTip="Type an item name and press Enter"/>
                <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="🔍"
                        Margin="6,0,0,0" Click="OnSearchClick" ToolTip="Look up"/>
            </Grid>
            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="Body"/>
            </ScrollViewer>
            <!-- MouseLeftButtonDown must be swallowed here: it otherwise bubbles to the
                 window's OnDrag, DragMove() captures the mouse, and the Up that opens the
                 browser never arrives (discussion #46 — the link just nudged the window). -->
            <TextBlock x:Name="WikiLink" FontSize="11" Margin="0,8,0,0" Cursor="Hand"
                       Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed"
                       MouseLeftButtonDown="OnLinkDown"
                       MouseLeftButtonUp="OnOpenWiki" Text="Open wiki page ↗"/>
        </StackPanel>
    </Border>
</Window>
